# --- Python (conda env, not venv) ---
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.pyright/
# conda env lives outside the repo; ignore any local env dir if created
/env/
/.conda/

# --- Node / Next.js ---
node_modules/
.next/
out/

# --- Playwright MCP scratch (screenshots / snapshots from browser verification) ---
.playwright-mcp/

# --- Env files ---
.env
.env.*
*.env
!.env.example

# --- SUMO outputs ---
*.fcd.xml
# large generated networks (hand-authored ones can be force-added)
*.net.xml
# raw OSM extracts pulled by osmGet (large, regenerable)
*.osm.xml

# --- Generated trajectory artifacts (the contract SCHEMA stays tracked; runs do not) ---
contract/runs/

# --- Editor-generated web artifacts (5.2b): latest.json is only the current-run pointer, and each editor run
# writes a per-run <run_id>.json — don't track that churn. NOTE: .gitignore does NOT untrack already-committed
# files, so the pinned showcase run + the committed test fixtures stay tracked; only NEW runs + latest.json here.
web/public/latest.json
web/public/multimodal-scenario-*.json
web/public/multimodal-baseline-*.json

# --- Claude Code worktrees ---
.claude/worktrees/

# --- Local planning docs (pre-existing) ---
docs/

# V2.3d: the pinned run's committed graphs sidecar (the split-view fixture) — the glob above
# hides every run's sidecar as churn, this ONE is negated back in deliberately.
!web/public/multimodal-scenario-20260702T044134Z-graphs.json
# V2.5d: the static demo's MODERN run (0.9.0, institutional voices + the ends chip) — committed
# so the demo bundle + fresh clones carry a current-schema exemplar beside the pinned run.
!web/public/multimodal-scenario-20260814T063253Z.json
# V2.7a: the two COMMITTED per-run reports (singleton-class — the Read stage renders from them;
# the pinned run anchors discourse.spec's report leg, the MODERN run is the landing's example).
!web/public/multimodal-scenario-20260702T044134Z-report.json
!web/public/multimodal-scenario-20260814T063253Z-report.json
# V2.7a C5: the latest-report POINTER is server-side alignment state, never committed (the
# latest.json symmetry); the payload singletons are retired — per-run reports are the record.
web/public/latest-report.json
web/public/latest-report.md
