# Copy to python/.env and fill in what you have. Every key is optional for the quant pipeline
# (simulation + scorecard run with NO keys); each unlocks a specific enrich layer.

# DeepSeek — the report + chat + interview spine PINS this provider (long prompts, prefix
# caching; report.py / server.py default to it). Without it: no report generation, no
# "Ask the report", no interviews. https://platform.deepseek.com
DEEPSEEK_API_KEY=

# Groq — the persona-voices default (free tier, strict structured JSON). reactions.py uses
# PROVIDER=groq unless overridden. Without it: no 212-voice enrich (unless another provider).
GROQ_API_KEY=

# Gemini — optional alternate provider (tiny free tier: flash = 20 req/day; flash-lite often
# 503s). Only needed if you select PROVIDER=gemini.
GEMINI_API_KEY=
