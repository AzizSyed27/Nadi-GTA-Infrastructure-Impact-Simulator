<configuration>
  <!-- V2.1b calibrated AM-peak demand (t=0 == 07:00; departs 0-7200s). Generated by
       demand_calibration.py sample — provenance in data/demand/. SEPARATE from the synthetic
       corridor.sumocfg / corridor.multimodal.sumocfg (golden test + default harness). -->
  <input>
    <net-file value="../corridor.net.xml"/>
    <route-files value="calibrated.am.rou.xml,calibrated.am.bike.rou.xml,calibrated.am.ped.rou.xml"/>
  </input>
  <time>
    <begin value="0"/>
    <end value="10800"/>
  </time>
  <processing>
    <pedestrian.model value="striping"/>
  </processing>
</configuration>
